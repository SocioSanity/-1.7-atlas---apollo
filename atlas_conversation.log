#include <stdio.h>
#include <stdlib.h>
#include <ctype.h>
#include <limits.h>

#define SIZE_MAX ((size_t) -1)

int parse_size(const char *text, size_t *out) {
    if (text == NULL || *text == '\0') {
        return 0; // Empty input or null pointer
    }

    int sign = 1;
    if (*text == '-') {
        sign = -1;
        text++;
    } else if (*text == '+') {
        text++;
    }

    size_t size = 0;
    while (isdigit(*text)) {
        size = size * 10 + (*text - '0');
        text++;
    }

    if (*text != '\0') {
        return 0; // Non-digit characters found
    }

    if (size > SIZE_MAX) {
        return 0; // Overflow
    }

    *out = sign * size;
    return 1;
}

