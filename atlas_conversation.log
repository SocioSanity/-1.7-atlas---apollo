#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <ctype.h>

size_t parse_size(const char *text, size_t *out) {
    if (text == NULL || out == NULL) {
        return 0;
    }

    if (strlen(text) == 0) {
        return 0;
    }

    if (text[0] == '-') {
        if (strlen(text) == 1) {
            return 0;
        }
        if (text[1] == '0') {
            return 0;
        }
        if (text[1] == '-') {
            return 0;
        }
        return 0;
    }

    if (isdigit(text[0])) {
        size_t num = 0;
        for (size_t i = 1; i < strlen(text); i++) {
            if (!isdigit(text[i])) {
                return 0;
            }
            num = num * 10 + (text[i] - '0');
        }
        *out = num;
        return 1;
    }

    return 0;
}

int main() {
    char text[] = "1234567890";
    size_t out;
    parse_size(text, &out);
    printf("Parsed size: %zu\n", out);
    return 0;
}
