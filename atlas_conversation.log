To solve this problem, we need to implement a dynamic integer stack with the specified features. We'll use a `struct` to represent the stack, including a pointer to the top of the stack and a size limit. We'll also include functions to push, pop, peek, and check for overflow. Additionally, we'll handle memory allocation and reallocation safely.

Here's the complete C program:

```c
#include <stdio.h>
#include <stdlib.h>

#define SIZE_ MAX

struct Stack {
    int *data;
    int top;
    int size;
};

void initStack(struct Stack *stack) {
    stack->data = (int *)malloc(SIZE_ * sizeof(int));
    if (stack->data == NULL) {
        fprintf(stderr, "Memory allocation failed\n");
        exit(EXIT_FAILURE);
    }
    stack->top = -1;
    stack->size = SIZE_;
}

void push(struct Stack *stack, int value) {
    if (stack->top == stack->size - 1) {
        // Stack overflow
        fprintf(stderr, "Stack overflow\n");
        exit(EXIT_FAILURE);
    }
    stack->data[++stack->top] = value;
}

int pop(struct Stack *stack) {
    if (stack->top == -1) {
        // Stack underflow
        fprintf(stderr, "Stack underflow\n");
        exit(EXIT_FAILURE);
    }
    return stack->data[stack->top--];
}

int peek(struct Stack *stack) {
    if (stack->top == -1) {
        // Stack underflow
        fprintf(stderr, "Stack underflow\n");
        exit(EXIT_FAILURE);
    }
    return stack->data[stack->top];
}

void printStack(const struct Stack *stack) {
    if (stack->top == -1) {
        printf("Stack is empty\n");
        return;
    }
    for (int i = stack->top; i >= 0; i--) {
        printf("%d ", stack->data[i]);
    }
    printf("\n");
}

void testGrowth(struct Stack *stack) {
    for (int i = 0; i < 10; i++) {
        push(stack, i);
        printStack(stack);
    }
    printf("Stack size after growth: %d\n", stack->size);
}

int main() {
    struct Stack stack;
    initStack(&stack);

    testGrowth(&stack);

    free(stack.data);
    return 0;
}
``


